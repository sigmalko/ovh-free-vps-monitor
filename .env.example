# Skopiuj do .env (obok docker-compose.yml). Wszystkie zmienne są opcjonalne — to tylko nadpisania domyślnych.
# UWAGA: tutaj NIE wpisuj tokenu GitHub — token trzymamy w pliku-sekrecie (patrz README).

# Harmonogram w formacie crona (minuta godzina dzień miesiąc dzień_tygodnia).
CRON_SCHEDULE=*/10 * * * *
TZ=Europe/Warsaw

# Repozytorium na issue.
GITHUB_REPOSITORY=sigmalko/ovh-free-vps-monitor

# Kraje do powiadomień (ISO, po przecinku). Puste = wszystkie kraje UE.
# COUNTRIES=PL,DE

# Które plany sprawdzać (regex na kodzie planu). Puste = tylko oferta publiczna: ^vps-\d{4}-model\d+(\.LZ)?$
# Wszystkie plany z katalogu (łącznie ze starszymi, niewidocznymi na stronie): PLAN_PATTERN=.*
# PLAN_PATTERN=

# Subsydiariusz OVH (wpływa na katalog planów i ceny).
OVH_SUBSIDIARY=PL

# Ścieżka do pliku z tokenem GitHub na hoście (domyślnie ./secrets/github_token).
# Linux:   GITHUB_TOKEN_FILE_HOST=/etc/ovh-monitor/github_token
# Windows: GITHUB_TOKEN_FILE_HOST=C:/ProgramData/ovh-monitor/github_token
# GITHUB_TOKEN_FILE_HOST=./secrets/github_token
